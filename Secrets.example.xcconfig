// Copy to Secrets.xcconfig (git-ignored) and set it as the configuration file
// for the MiniVid target: Project > Info > Configurations > Debug/Release.
//
// Without it the community feed is simply off — the app builds, generates and
// exports video exactly the same, it just does not publish anywhere.
//
// The anon key is publishable *only* if the row-level-security policies of the
// project behind it are known to be correct. Use your own project, not one you
// found in someone else's repository.

SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY =
